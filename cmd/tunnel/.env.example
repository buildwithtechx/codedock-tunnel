# Public relay
CODEDOCK_PORT=8081
CODEDOCK_APP_NAME=codedock-tunnel-relay
CODEDOCK_ENV=development
CODEDOCK_RELAY_ID=relay-local

# Production relay certificates should cover *.tunnel.codedock-tunnel.dev.
CODEDOCK_REQUIRE_TLS=false
CODEDOCK_TLS_CERT_FILE=
CODEDOCK_TLS_KEY_FILE=

# Use tunnel.localhost locally. In production configure one wildcard DNS record
# for *.tunnel.codedock-tunnel.dev and point TUNNEL_DOMAIN at that domain.
CODEDOCK_TUNNEL_DOMAIN=tunnel.localhost
CODEDOCK_TUNNEL_REQUIRE_TLS=false
CODEDOCK_TUNNEL_TOKEN_TTL=24h
CODEDOCK_TUNNEL_MAX_CONNECTIONS=1000
CODEDOCK_TUNNEL_MAX_TUNNELS=1000
CODEDOCK_TUNNEL_MAX_BYTES=0
CODEDOCK_TUNNEL_MAX_BANDWIDTH_BYTES=0
CODEDOCK_TUNNEL_HEARTBEAT_INTERVAL=20s
CODEDOCK_TUNNEL_READ_TIMEOUT=90s
CODEDOCK_TUNNEL_MAX_FRAME_BYTES=16777216
CODEDOCK_TUNNEL_DRAIN_TIMEOUT=10s

# Redis coordination with the API and workers
CODEDOCK_REDIS_HOST=localhost
CODEDOCK_REDIS_PORT=6379
CODEDOCK_REDIS_PASSWORD=
CODEDOCK_REDIS_DB=0

# Private API communication
CODEDOCK_INTERNAL_API_URL=http://localhost:8080
CODEDOCK_INTERNAL_API_SECRET=generate_a_secure_random_string_here

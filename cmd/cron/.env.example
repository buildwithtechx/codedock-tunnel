# Scheduled maintenance worker
CODEDOCK_APP_NAME=codedock-cron
CODEDOCK_ENV=development

# Shared persistence
CODEDOCK_DATABASE_URL=postgresql://codedock:codedock@localhost:5432/codedock
CODEDOCK_DATABASE_MAX_CONNS=5
CODEDOCK_REDIS_HOST=localhost
CODEDOCK_REDIS_PORT=6379
CODEDOCK_REDIS_PASSWORD=
CODEDOCK_REDIS_DB=0

# Private API communication
CODEDOCK_INTERNAL_API_URL=http://localhost:8080
CODEDOCK_INTERNAL_API_SECRET=generate_a_secure_random_string_here

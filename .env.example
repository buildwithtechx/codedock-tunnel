# App Configuration
CODEDOCK_PORT=8080
CODEDOCK_APP_NAME=codedock-tunnel
CODEDOCK_ENV=development
CODEDOCK_LOG_LEVEL=info
CODEDOCK_SHUTDOWN_TIMEOUT=10s
CODEDOCK_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CODEDOCK_CORS_ORIGIN=http://localhost:3000
CODEDOCK_PUBLIC_API_URL=http://localhost:8080

# Database
CODEDOCK_DATABASE_URL=postgresql://codedock:codedock@localhost:5432/codedock
CODEDOCK_DATABASE_MAX_CONNS=25
CODEDOCK_DB_CONN_MAX_LIFETIME=30m
CODEDOCK_DB_CONN_MAX_IDLE_TIME=5m

# Internal API secret
# Shared server-to-server secret
CODEDOCK_INTERNAL_API_SECRET=generate_a_secure_random_string_here
CODEDOCK_INTERNAL_API_URL=http://localhost:8080

# OAuth session settings
CODEDOCK_SESSION_TTL=720h
CODEDOCK_DEVICE_LOGIN_TTL=10m
CODEDOCK_AUTH_COOKIE_NAME=codedock_session
CODEDOCK_AUTH_COOKIE_SECURE=false
CODEDOCK_AUTH_ENCRYPTION_KEY=replace_with_16_24_or_32_byte_key

# GitHub OAuth
CODEDOCK_GITHUB_CLIENT_ID=your_github_client_id
CODEDOCK_GITHUB_CLIENT_SECRET=your_github_client_secret
CODEDOCK_OAUTH_STATE_TTL=10m

# Google OAuth
CODEDOCK_GOOGLE_CLIENT_ID=your_google_client_id
CODEDOCK_GOOGLE_CLIENT_SECRET=your_google_client_secret

# Zepto Mail
CODEDOCK_MAIL_FROM=you@example.com
CODEDOCK_ZEPTO_API_KEY=your_zepto_api_key

# Redis
CODEDOCK_REDIS_HOST=localhost
CODEDOCK_REDIS_PORT=6379
CODEDOCK_REDIS_PASSWORD=
CODEDOCK_REDIS_DB=0

# Tunnel
CODEDOCK_TUNNEL_DOMAIN=tunnel.localhost
CODEDOCK_TUNNEL_TOKEN_TTL=24h
CODEDOCK_TUNNEL_MAX_CONNECTIONS=1000
CODEDOCK_TUNNEL_MAX_BYTES=0
CODEDOCK_TUNNEL_REQUIRE_TLS=false
CODEDOCK_AGENT_INACTIVITY_TIMEOUT=90s

# Polar Configuration
CODEDOCK_BILLING_ENABLED=false
CODEDOCK_POLAR_BASE_URL=https://sandbox-api.polar.sh
CODEDOCK_POLAR_ACCESS_TOKEN=polar_oat_xxxxxxxxxxxxxxxxx
CODEDOCK_POLAR_WEBHOOK_SECRET=your_polar_webhook_secret_here
CODEDOCK_POLAR_SERVER=sandbox

# Polar Product IDs - Monthly
CODEDOCK_POLAR_PRODUCT_RAY=prod_xxxxxxxxxxxxxxxx
CODEDOCK_POLAR_PRODUCT_BEAM=prod_xxxxxxxxxxxxxxxx
CODEDOCK_POLAR_PRODUCT_PULSE=prod_xxxxxxxxxxxxxxxx

# Polar Product IDs - Yearly
CODEDOCK_POLAR_PRODUCT_RAY_YEARLY=prod_xxxxxxxxxxxxxxxx
CODEDOCK_POLAR_PRODUCT_BEAM_YEARLY=prod_xxxxxxxxxxxxxxxx
CODEDOCK_POLAR_PRODUCT_PULSE_YEARLY=prod_xxxxxxxxxxxxxxxx

# Paystack fallback billing provider
CODEDOCK_PAYSTACK_BASE_URL=https://api.paystack.co
CODEDOCK_PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
CODEDOCK_BILLING_WEBHOOK_SECRET=your_billing_webhook_secret_here

# Standalone CLI connection settings
CODEDOCK_TUNNEL_API_URL=http://localhost:8080
CODEDOCK_TUNNEL_RELAY_URL=ws://localhost:8081
CODEDOCK_TUNNEL_API_KEY=
CODEDOCK_TUNNEL_CONFIG_PATH=.config/codedock-tunnel/config.json

{
  "name": "@codedock-tunnel/express",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly --noEmit false",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "description": "Express integration for Codedock Tunnel",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@codedock-tunnel/sdk-ts": "0.1.0"
  },
  "peerDependencies": {
    "express": ">=4"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6"
  }
}

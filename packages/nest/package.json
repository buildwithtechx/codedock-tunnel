{
  "name": "@codedock/nest",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "build": "tsup && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly --noEmit false",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "description": "NestJS integration for Codedock Tunnel",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@codedock/sdk-ts": "0.1.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}

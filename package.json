{
  "name": "codedock-tunnel",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone tunneling platform with Go relays, a TypeScript dashboard, and a Tauri desktop client",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,dashboard -c blue,magenta \"go run ./cmd/tunnel-server\" \"npm run dev --workspace apps/dashboard\"",
    "build": "npm run build:dashboard && npm run build:server && npm run build:agent && npm run build:cli",
    "build:dashboard": "npm run generate-routes && npm run build --workspace apps/dashboard",
    "dev:desktop": "npm run dev --workspace apps/desktop",
    "build:desktop": "npm run build --workspace apps/desktop",
    "build:server": "go build -ldflags='-s -w' -o bin/tunnel-server ./cmd/tunnel-server",
    "build:agent": "go build -ldflags='-s -w' -o bin/tunnel-agent ./cmd/tunnel-agent",
    "build:cli": "go build -ldflags='-s -w' -o bin/codedock-tunnel ./cmd/codedock-tunnel",
    "generate-routes": "npm run generate-routes --workspace apps/dashboard",
    "fmt": "go fmt ./... && npm run format:fix",
    "format:fix": "biome check --write apps packages",
    "format": "biome check apps packages",
    "typecheck": "tsc --noEmit -p apps/dashboard/tsconfig.json",
    "test": "go test ./... && npm run test --workspaces --if-present",
    "clean": "rm -rf bin apps/dashboard/dist apps/desktop/src-tauri/target"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "concurrently": "^10.0.4",
    "typescript": "^7.0.2"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codedock-tunnel.dev/protocol/messages.json",
  "title": "Codedock Tunnel Protocol",
  "protocolVersion": 1,
  "type": "object",
  "required": ["version", "type"],
  "properties": {
    "version": { "const": 1 },
    "type": {
      "enum": [
        "open_tunnel",
        "open_tunnel_ack",
        "close_tunnel",
        "data",
        "heartbeat",
        "error"
      ]
    },
    "request_id": { "type": "string" },
    "payload": {}
  },
  "additionalProperties": false,
  "$defs": {
    "open_tunnel": {
      "type": "object",
      "required": ["token", "local_port", "protocol"],
      "properties": {
        "token": { "type": "string" },
        "local_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "subdomain": { "type": "string" },
        "protocol": { "type": "string", "enum": ["http", "https", "tcp"] },
        "custom_domain": { "type": "string" }
      },
      "additionalProperties": false
    },
    "open_tunnel_ack": {
      "type": "object",
      "required": ["tunnel_id", "public_url"],
      "properties": {
        "tunnel_id": { "type": "string" },
        "public_url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "close_tunnel": {
      "type": "object",
      "required": ["tunnel_id"],
      "properties": {
        "tunnel_id": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "required": ["tunnel_id", "stream_id", "data"],
      "properties": {
        "tunnel_id": { "type": "string" },
        "stream_id": { "type": "string" },
        "data": { "type": "string", "contentEncoding": "base64" }
      },
      "additionalProperties": false
    },
    "heartbeat": {
      "type": "object",
      "required": ["timestamp"],
      "properties": { "timestamp": { "type": "integer" } },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
